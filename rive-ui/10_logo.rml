                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="54" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- neon tube flicker, a few quick dropouts per cycle -->
        <LinearAnimation loopValue="loop" duration="240" name="Flicker" id="2:31">
            <KeyedObject objectId="2:10">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="2:13">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="FF00E5FF" frame="0" interpolationType="hold"/>
                    <KeyFrameColor value="3300E5FF" frame="150" interpolationType="hold"/>
                    <KeyFrameColor value="FF00E5FF" frame="154" interpolationType="hold"/>
                    <KeyFrameColor value="5500E5FF" frame="160" interpolationType="hold"/>
                    <KeyFrameColor value="FF00E5FF" frame="163" interpolationType="hold"/>
                    <KeyFrameColor value="FF00E5FF" frame="240" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation loopValue="loop" duration="150" name="Slither" id="2:32">
            <KeyedObject objectId="2:21">
                <KeyedProperty property="offset">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="150" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="Logo SM" id="2:90">
            <StateMachineLayer name="Title" id="2:91">
                <AnyState x="0" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
